<div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
  
  <!-- Хлебные крошки (Навигация) -->
  <div class="mb-6">
    <%= link_to "← Назад на Дэшборд", root_path, class: "text-sm text-blue-600 hover:text-blue-800" %>
  </div>

  <div class="md:flex md:gap-8">
    
    <!-- ЛЕВАЯ КОЛОНКА: Зона Drag & Drop (Перетащи и брось) -->
    <!-- На больших экранах займет 1/3 ширины -->
    <div class="md:w-1/3 mb-8 md:mb-0">
      <div class="bg-white p-6 rounded-xl shadow border border-gray-100">
        <h2 class="text-lg font-medium text-gray-900 mb-4">Импорт транзакций</h2>
        
        <!-- UI для Drag & Drop: используем dashed (пунктир) для визуальной области загрузки -->
        <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-md hover:border-blue-500 hover:bg-blue-50 transition-colors cursor-pointer text-center">
          <div class="space-y-1 text-center">
            <!-- Иконка облака -->
            <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48" aria-hidden="true">
              <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div class="flex text-sm text-gray-600 justify-center">
              <span class="relative cursor-pointer bg-transparent rounded-md font-medium text-blue-600 hover:text-blue-500 focus-within:outline-none">
                <span>Загрузите файл</span>
              </span>
              <p class="pl-1">или перетащите сюда</p>
            </div>
            <p class="text-xs text-gray-500">
              CSV, Excel или PDF до 10MB
            </p>
          </div>
        </div>
        
        <div class="mt-4">
          <button type="button" class="w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-green-600 hover:bg-green-700">
            Распознать (AI)
          </button>
        </div>
      </div>
    </div>

    <!-- ПРАВАЯ КОЛОНКА: Таблица транзакций -->
    <!-- На больших экранах займет 2/3 ширины -->
    <div class="md:w-2/3">
      <div class="bg-white shadow rounded-xl border border-gray-100 overflow-hidden">
        <div class="px-4 py-5 border-b border-gray-200 sm:px-6 flex justify-between items-center">
          <h3 class="text-lg leading-6 font-medium text-gray-900">
            Распознанные операции (Заглушка)
          </h3>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
            Сбербанк
          </span>
        </div>
        
        <!-- Таблица (Table) -->
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Дата</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Описание (Мерчант)</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Сумма</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Категория (AI)</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              
              <!-- Строка 1: Подписка -->
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">12 Окт 2023</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">YANDEX *PLUS</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-red-600 font-semibold">- 299 ₽</td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <!-- Бейдж (Badge) - цветной тег -->
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800 border border-purple-200">
                    ✨ AI: Подписки
                  </span>
                </td>
              </tr>

              <!-- Строка 2: Продукты -->
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">11 Окт 2023</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">IP IVANOV PYATEROCHKA</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-red-600 font-semibold">- 1 450 ₽</td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 border border-blue-200">
                    ✨ AI: Продукты
                  </span>
                </td>
              </tr>
              
              <!-- Строка 3: Доход -->
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">10 Окт 2023</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">ЗАЧИСЛЕНИЕ ЗАРПЛАТЫ</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-green-600 font-semibold">+ 150 000 ₽</td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800 border border-green-200">
                    ✨ AI: Зарплата
                  </span>
                </td>
              </tr>

            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</div>