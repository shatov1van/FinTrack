<!-- Контейнер на весь экран, центрирующий контент -->
<div class="auth-shell page-pattern flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  
  <!-- Сама белая карточка -->
  <div class="auth-card max-w-md w-full space-y-8 p-10 rounded-xl shadow-lg">
    
    <!-- Заголовок -->
    <div>
      <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
        Вход в FinTrack
      </h2>
      <p class="mt-2 text-center text-sm text-gray-600">
        Управляйте своими финансами с умом
      </p>
    </div>

    <!-- Форма входа (Devise) -->
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 space-y-6" }) do |f| %>
      <div class="rounded-md shadow-sm -space-y-px">
        
        <!-- Поле Email -->
        <div class="mb-4">
          <%= f.label :email, "Электронная почта", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "appearance-none rounded-md relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-blue-500 focus:border-blue-500 focus:z-10 sm:text-sm", placeholder: "example@mail.com" %>
        </div>

        <!-- Поле Пароль -->
        <div class="mb-4">
          <%= f.label :password, "Пароль", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "appearance-none rounded-md relative block w-full px-3 py-2 border border-gray-300 placeholder-gray-500 text-gray-900 focus:outline-none focus:ring-blue-500 focus:border-blue-500 focus:z-10 sm:text-sm", placeholder: "••••••••" %>
        </div>
      </div>

      <!-- Чекбокс "Запомнить меня" -->
      <% if devise_mapping.rememberable? %>
        <div class="flex items-center justify-between">
          <div class="flex items-center">
            <%= f.check_box :remember_me, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
            <%= f.label :remember_me, "Запомнить меня", class: "ml-2 block text-sm text-gray-900" %>
          </div>
        </div>
      <% end %>

      <!-- Кнопка "Войти" -->
      <div>
        <%= f.submit "Войти", class: "theme-auth-submit group relative w-full cursor-pointer" %>
      </div>
    <% end %>

    <!-- Ссылки на регистрацию и восстановление пароля -->
    <div class="mt-4 text-center">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>