<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for(:title) || "FinTrack" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="FinTrack">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 dark:bg-brand-purple transition-colors duration-300 min-h-screen">
    <!-- НАЧАЛО ШАПКИ -->
    <header class="p-4 bg-gray-800 dark:bg-gray-900 text-white flex justify-between items-center shadow-md transition-colors duration-300">
      <div class="font-bold text-xl text-brand-orange">FinTrack</div>
      
      <div class="flex gap-4 items-center">
        <!-- Кнопка переключения темы -->
        <button id="theme-toggle" type="button" class="px-3 py-1 bg-gray-700 hover:bg-gray-600 rounded text-sm transition-colors cursor-pointer border border-gray-600">
          🌓 Тема
        </button>

        <% if user_signed_in? %>
          <span class="text-sm">Привет, <%= current_user.email %>!</span>
          <%= link_to "Выписки", bank_statements_path, class: "text-sm hover:text-brand-orange" %>
          <!-- Экран, на котором видно, что вы залогинены -->

          <!-- Работа с сессиями: кнопка выхода -->
          <%= button_to "Выйти", destroy_user_session_path, method: :delete, class: "bg-brand-orange px-3 py-1 rounded hover:bg-brand-orangeHover transition-colors cursor-pointer text-white border-none" %>
        <% else %>
          <%= link_to "Войти", new_user_session_path, class: "bg-gray-700 px-3 py-1 rounded hover:bg-gray-600 transition-colors text-white" %>
          <%= link_to "Регистрация", new_user_registration_path, class: "bg-brand-orange px-3 py-1 rounded hover:bg-brand-orangeHover transition-colors text-white" %>
        <% end %>
      </div>
    </header>
    <!-- КОНЕЦ ШАПКИ -->

    <!-- Здесь будет отображаться контент конкретной страницы (дэшборда) -->
    <main class="p-4">
      <!-- Всплывающие уведомления Devise (успешный вход, ошибки и т.д.) -->
      <p class="notice text-green-600 dark:text-green-400"><%= notice %></p>
      <p class="alert text-red-600 dark:text-red-400"><%= alert %></p>
      <%= yield %>
    </main>

    <script>
      // Применяем сохраненную тему сразу при загрузке
      if (localStorage.getItem('theme') === 'dark') {
        document.documentElement.classList.add('dark');
      }

      // Вешаем обработчик клика (работает и с Turbo при переходах по страницам)
      document.addEventListener('turbo:load', () => {
        const btn = document.getElementById('theme-toggle');
        if (btn) {
          btn.onclick = () => {
            document.documentElement.classList.toggle('dark');
            const isDark = document.documentElement.classList.contains('dark');
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
          };
        }
      });
    </script>
  </body>
</html>