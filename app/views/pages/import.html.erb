<div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
  
  <!-- Хлебные крошки (Навигация) -->
  <div class="mb-6">
    <%= link_to "← Назад на Дэшборд", root_path, data: { turbo_frame: "_top" }, class: "theme-link text-sm" %>
  </div>

  <div class="md:flex md:gap-8">
    
    <!-- ЛЕВАЯ КОЛОНКА: Зона Drag & Drop (Перетащи и брось) -->
    <!-- На больших экранах займет 1/3 ширины -->
    <div class="md:w-1/3 mb-8 md:mb-0">
      <div class="theme-card p-6 rounded-xl shadow">
        <h2 class="theme-heading text-lg font-bold mb-4">Импорт транзакций</h2>
        <%= form_with url: import_path, method: :post, multipart: true do |form| %>
        <div class="mb-4">
          <%= form.label :bank_name, "Банк", class: "form-label block text-sm font-bold" %>
          <%= form.select :bank_name, [["Определить автоматически", ""]] + popular_banks, {}, class: "theme-input mt-1 block w-full rounded-md" %>
        </div>
        <div class="mt-1 flex justify-center px-6 pt-5 pb-6 border-2 border-gray-300 border-dashed rounded-md hover:border-blue-500 hover:bg-blue-50 transition-colors text-center">
          <div class="space-y-1 text-center">
            <!-- Иконка облака -->
            <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48" aria-hidden="true">
              <path d="M28 8H12a4 4 0 00-4 4v20m32-12v8m0 0v8a4 4 0 01-4 4H12a4 4 0 01-4-4v-4m32-4l-3.172-3.172a4 4 0 00-5.656 0L28 28M8 32l9.172-9.172a4 4 0 015.656 0L28 28m0 0l4 4m4-24h8m-4-4v8m-12 4h.02" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <div class="flex text-sm justify-center">
              <%= form.file_field :statement_file, accept: ".csv,.xlsx,.xls,.pdf", required: true, class: "theme-file text-sm" %>
              <p class="pl-1">или перетащите сюда</p>
            </div>
            <p class="theme-muted text-xs">
              CSV, Excel или PDF до 10MB
            </p>
          </div>
        </div>
        
        <div class="mt-4">
          <%= form.submit "Распознать и импортировать", class: "w-full flex justify-center py-2 px-4 rounded-md shadow-sm text-sm font-bold text-white bg-green-600 hover:bg-green-700 cursor-pointer" %>
        </div>
        <% end %>
      </div>
    </div>

    <!-- ПРАВАЯ КОЛОНКА: Таблица транзакций -->
    <!-- На больших экранах займет 2/3 ширины -->
    <div class="md:w-2/3" data-controller="polling" data-polling-url-value="<%= import_path %>" data-polling-interval-value="2000">
      <div class="theme-card shadow rounded-xl overflow-hidden">
        <div class="px-4 py-5 border-b border-gray-200 sm:px-6 flex justify-between items-center">
          <h3 class="theme-heading text-lg leading-6 font-bold">
            Последние импортированные операции
          </h3>
          <span class="status-badge inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold">
            <%= current_user.bank_statements.order(created_at: :desc).first&.bank_name || "Банк определяется" %>
          </span>
          <% latest_statement = current_user.bank_statements.order(created_at: :desc).first %>
          <% if latest_statement.present? %>
            <span class="theme-muted text-xs font-bold"><%= latest_statement.status %></span>
          <% end %>
        </div>
        
        <!-- Таблица (Table) -->
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="theme-table-head">
              <tr>
                <th scope="col" class="table-header px-6 py-3 text-left text-xs font-bold uppercase tracking-wider">Дата</th>
                <th scope="col" class="table-header px-6 py-3 text-left text-xs font-bold uppercase tracking-wider">Описание (Мерчант)</th>
                <th scope="col" class="table-header px-6 py-3 text-left text-xs font-bold uppercase tracking-wider">Сумма</th>
                <th scope="col" class="table-header px-6 py-3 text-left text-xs font-bold uppercase tracking-wider">Категория</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% if latest_statement&.error_message.present? %>
                <tr>
                  <td class="table-cell px-6 py-4 text-sm font-bold text-red-600" colspan="4"><%= latest_statement.error_message %></td>
                </tr>
              <% end %>
              <% if latest_statement&.status == "parsed" && latest_statement.imported_count.to_i.zero? %>
                <tr>
                  <td class="table-cell px-6 py-4 text-sm font-bold" colspan="4">Файл обработан, но новые операции не добавлены: все записи уже были импортированы или не прошли формат.</td>
                </tr>
              <% end %>
              <% current_user.financial_transactions.includes(:category).order(transaction_date: :desc).each do |transaction| %>
                <tr>
                  <td class="table-cell px-6 py-4 whitespace-nowrap text-sm font-bold"><%= l(transaction.transaction_date) %></td>
                  <td class="table-cell px-6 py-4 whitespace-nowrap text-sm font-bold" title="<%= transaction.merchant %>"><%= merchant_label(transaction.merchant) %></td>
                  <td class="px-6 py-4 whitespace-nowrap text-sm <%= transaction.transaction_type == "income" ? "text-green-600" : "text-red-600" %> font-semibold"><%= transaction.transaction_type == "income" ? "+" : "-" %> <%= number_to_currency(transaction.amount, unit: "₽", format: "%n %u", delimiter: " ", separator: ",") %></td>
                  <td class="table-cell px-6 py-4 whitespace-nowrap text-sm font-bold"><%= transaction.category&.name || "Без категории" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>
</div>