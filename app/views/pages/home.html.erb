<% if user_signed_in? %>
  <!-- ========================================== -->
  <!-- ДЭШБОРД (Виден только авторизованным)      -->
  <!-- ========================================== -->
  
  <!-- max-w-7xl mx-auto центрирует контент и ограничивает максимальную ширину -->
  <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
    
    <!-- Заголовок страницы и кнопка импорта -->
    <div class="mb-8 flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold text-gray-900">Обзор финансов</h1>
        <p class="mt-1 text-sm text-gray-500">Сводка по вашим счетам и последним операциям за текущий месяц.</p>
      </div>
      
      <!-- Кнопка перехода на страницу загрузки -->
      <%= link_to "Загрузить выписку", import_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
    </div>

    <!-- 1. БЛОК СВОДКИ (Grid-сетка) -->
    <!-- На мобильных это 1 колонка (grid-cols-1), на экранах от размера 'sm' — 3 колонки (sm:grid-cols-3) -->
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-3 mb-8">
      
      <!-- Карточка: Общий баланс -->
      <div class="bg-white overflow-hidden shadow rounded-xl border border-gray-100">
        <div class="px-4 py-5 sm:p-6">
          <dt class="text-sm font-medium text-gray-500 truncate">Общий баланс</dt>
          <dd class="mt-1 text-3xl font-semibold text-gray-900">125 000 ₽</dd>
        </div>
      </div>

      <!-- Карточка: Доходы -->
      <div class="bg-white overflow-hidden shadow rounded-xl border border-gray-100">
        <div class="px-4 py-5 sm:p-6">
          <dt class="text-sm font-medium text-gray-500 truncate">Доходы</dt>
          <dd class="mt-1 text-3xl font-semibold text-green-600">+ 150 000 ₽</dd>
        </div>
      </div>

      <!-- Карточка: Расходы -->
      <div class="bg-white overflow-hidden shadow rounded-xl border border-gray-100">
        <div class="px-4 py-5 sm:p-6">
          <dt class="text-sm font-medium text-gray-500 truncate">Расходы</dt>
          <dd class="mt-1 text-3xl font-semibold text-red-600">- 25 000 ₽</dd>
        </div>
      </div>
    </div>

    <!-- 2. БЛОК ГРАФИКОВ (Заглушки) -->
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-2 mb-8">
      
      <!-- Заглушка: Диаграмма категорий -->
      <!-- Используем dashed (пунктирную) рамку, чтобы показать, что это плейсхолдер -->
      <div class="bg-white shadow rounded-xl p-6 flex flex-col items-center justify-center h-72 border-2 border-dashed border-gray-300">
        <svg class="w-12 h-12 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"></path></svg>
        <span class="text-gray-500 font-medium">Здесь будет график расходов по категориям</span>
        <span class="text-sm text-gray-400 mt-2">(Интеграция Chart.js в будущем)</span>
      </div>

      <!-- Заглушка: Динамика баланса -->
      <div class="bg-white shadow rounded-xl p-6 flex flex-col items-center justify-center h-72 border-2 border-dashed border-gray-300">
        <svg class="w-12 h-12 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path></svg>
        <span class="text-gray-500 font-medium">Здесь будет график динамики баланса</span>
        <span class="text-sm text-gray-400 mt-2">(Линейный график)</span>
      </div>
    </div>

  </div>

<% else %>
  <!-- ========================================== -->
  <!-- ЛЕНДИНГ (Виден гостям)                     -->
  <!-- ========================================== -->
  
  <div class="bg-white min-h-[calc(100vh-80px)] flex flex-col justify-center">
    <div class="max-w-7xl mx-auto py-16 px-4 sm:py-24 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl font-extrabold text-gray-900 sm:text-5xl sm:tracking-tight lg:text-6xl">
        Возьмите финансы под <span class="text-blue-600">контроль</span>
      </h1>
      <p class="max-w-xl mt-5 mx-auto text-xl text-gray-500">
        FinTrack помогает анализировать выписки из разных банков, находить скрытые подписки и оптимизировать ваши расходы с помощью AI.
      </p>
      
      <!-- Кнопки призыва к действию -->
      <div class="mt-8 flex justify-center gap-4">
        <%= link_to "Начать бесплатно", new_user_registration_path, class: "inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 transition-colors" %>
        <%= link_to "Уже есть аккаунт", new_user_session_path, class: "inline-flex items-center justify-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-blue-700 bg-blue-100 hover:bg-blue-200 transition-colors" %>
      </div>
    </div>
  </div>
<% end %>